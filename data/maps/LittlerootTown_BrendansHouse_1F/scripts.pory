raw `
LittlerootTown_BrendansHouse_1F_EventScript_SetMovingBoxes::
	setmetatile 5, 4, METATILE_BrendansMaysHouse_MovingBox_Open, TRUE
	setmetatile 5, 2, METATILE_BrendansMaysHouse_MovingBox_Closed, TRUE
	return

LittlerootTown_BrendansHouse_1F_EventScript_CheckShowShoesManual::
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, LittlerootTown_BrendansHouse_1F_EventScript_ShowRunningShoesManual
	return

LittlerootTown_BrendansHouse_1F_EventScript_ShowRunningShoesManual::
	setmetatile 3, 7, METATILE_BrendansMaysHouse_BookOnTable, TRUE
	return

LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToStairs::
	setobjectxyperm LOCALID_PLAYERS_HOUSE_1F_MOM, 8, 4
	setobjectmovementtype LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP
	return

LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToTV::
	setobjectxyperm LOCALID_PLAYERS_HOUSE_1F_MOM, 4, 5
	setobjectmovementtype LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP
	return

LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToDoor::
	setobjectxyperm LOCALID_PLAYERS_HOUSE_1F_MOM, 9, 8
	setobjectmovementtype LOCALID_PLAYERS_HOUSE_1F_MOM, MOVEMENT_TYPE_FACE_UP
	return

LittlerootTown_BrendansHouse_1F_EventScript_GoUpstairsToSetClock::
	lockall
	msgbox Text_PlayersHouse_1F_Mom_GoSetTheClock, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs
	applymovement LOCALID_PLAYERS_HOUSE_1F_MOM, LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs
	waitmovement 0
	warp MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F, 7, 1
	waitstate
	releaseall
	end

LittlerootTown_BrendansHouse_1F_EventScript_PetalburgGymReport::
	lockall
	setvar VAR_0x8004, MALE
	setvar VAR_0x8005, LOCALID_PLAYERS_HOUSE_1F_MOM
	goto PlayersHouse_1F_EventScript_PetalburgGymReportMale
	end

LittlerootTown_BrendansHouse_1F_EventScript_YoureNewNeighbor::
	lockall
	playse SE_PIN
	applymovement LOCALID_RIVALS_HOUSE_1F_MOM, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_RIVALS_HOUSE_1F_MOM, Common_Movement_Delay48
	waitmovement 0
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
	applymovement LOCALID_RIVALS_HOUSE_1F_MOM, LittlerootTown_BrendansHouse_1F_Movement_RivalMomApproach
	waitmovement 0
	special GetRivalSonDaughterString
	msgbox RivalsHouse_1F_Text_OhYoureTheNewNeighbor, MSGBOX_DEFAULT
	setflag FLAG_MET_RIVAL_MOM
	setvar VAR_LITTLEROOT_HOUSES_STATE_MAY, 2
	releaseall
	end

LittlerootTown_BrendansHouse_1F_EventScript_GoSeeRoom::
	lockall
	setvar VAR_0x8004, LOCALID_PLAYERS_HOUSE_1F_MOM
	setvar VAR_0x8005, MALE
	applymovement VAR_0x8004, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	goto PlayersHouse_1F_EventScript_MomGoSeeRoom
	end

LittlerootTown_BrendansHouse_1F_EventScript_MeetRival0::
	lockall
	setvar VAR_0x8008, 0
	goto LittlerootTown_BrendansHouse_1F_EventScript_MeetRival
	end

LittlerootTown_BrendansHouse_1F_EventScript_MeetRival1::
	lockall
	setvar VAR_0x8008, 1
	goto LittlerootTown_BrendansHouse_1F_EventScript_MeetRival
	end

LittlerootTown_BrendansHouse_1F_EventScript_MeetRival2::
	lockall
	setvar VAR_0x8008, 2
	goto LittlerootTown_BrendansHouse_1F_EventScript_MeetRival
	end

LittlerootTown_BrendansHouse_1F_EventScript_MeetRival::
	playse SE_EXIT
	delay 10
	addobject LOCALID_RIVALS_HOUSE_1F_RIVAL
	delay 30
	playse SE_PIN
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, Common_Movement_Delay48
	waitmovement 0
	call_if_ne VAR_0x8008, 1, LittlerootTown_BrendansHouse_1F_EventScript_PlayerFaceBrendan
	playbgm MUS_ENCOUNTER_BRENDAN, TRUE
	call_if_eq VAR_0x8008, 0, LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer0
	call_if_eq VAR_0x8008, 1, LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer1
	call_if_eq VAR_0x8008, 2, LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer2
	msgbox RivalsHouse_1F_Text_BrendanWhoAreYou, MSGBOX_DEFAULT
	closemessage
	call_if_eq VAR_0x8008, 0, LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs0
	call_if_eq VAR_0x8008, 1, LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs1
	call_if_eq VAR_0x8008, 2, LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs2
	playse SE_EXIT
	removeobject LOCALID_RIVALS_HOUSE_1F_RIVAL
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_BRENDAN
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL
	clearflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM
	delay 30
	setvar VAR_LITTLEROOT_RIVAL_STATE, 3
	setvar VAR_LITTLEROOT_TOWN_STATE, 1
	savebgm MUS_DUMMY
	fadedefaultbgm
	releaseall
	end

LittlerootTown_BrendansHouse_1F_EventScript_PlayerFaceBrendan::
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer0::
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer0
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer1::
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer1
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanApproachPlayer2::
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer2
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs0::
	applymovement LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit0
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs0
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs1::
	applymovement LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit1
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs1
	waitmovement 0
	return

LittlerootTown_BrendansHouse_1F_EventScript_BrendanGoUpstairs2::
	applymovement LOCALID_PLAYER, LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit2
	applymovement LOCALID_RIVALS_HOUSE_1F_RIVAL, LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs2
	waitmovement 0
	return
`
movement(local) LittlerootTown_BrendansHouse_1F_Movement_PushTowardStairs {
	walk_up
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_RivalMomApproach {
	walk_down
	walk_right * 5
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer0 {
	walk_in_place_faster_left
	walk_left
	walk_in_place_faster_up
	walk_up * 4
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer1 {
	walk_up * 3
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanApproachPlayer2 {
	walk_in_place_faster_right
	walk_right
	walk_in_place_faster_up
	walk_up * 4
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit0 {
	delay_16
	delay_8
	walk_in_place_faster_right
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit1 {
	delay_16
	delay_8
	walk_in_place_faster_right
	delay_16 * 2
	walk_in_place_faster_up
	step_end
}

movement LittlerootTown_BrendansHouse_1F_Movement_PlayerWatchBrendanExit2 {
	delay_16
	delay_8
	walk_in_place_faster_left
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs0 {
	walk_in_place_faster_right
	walk_right
	walk_in_place_faster_up
	walk_up * 2
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs1{
	walk_in_place_faster_right
	walk_right
	walk_in_place_faster_up
	walk_up * 2
	walk_in_place_faster_left
	walk_left
	walk_in_place_faster_up
	walk_up
	step_end
}

movement(local) LittlerootTown_BrendansHouse_1F_Movement_BrendanGoUpstairs2 {
	walk_in_place_faster_left
	walk_left
	walk_in_place_faster_up
	walk_up * 2
	step_end
}


mapscripts LittlerootTown_BrendansHouse_1F_MapScripts {
	MAP_SCRIPT_ON_LOAD: MapScript_LittlerootTown_BrendansHouse_1F_OnLoad
	MAP_SCRIPT_ON_TRANSITION: MapScript_LittlerootTown_BrendansHouse_1F_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_LITTLEROOT_INTRO_STATE, 2: Script_LittlerootTown_BrendansHouse_1F_Event_EnterHouseWhenMovingIn
		VAR_LITTLEROOT_INTRO_STATE, 4: LittlerootTown_BrendansHouse_1F_EventScript_GoUpstairsToSetClock
		VAR_LITTLEROOT_INTRO_STATE, 5: LittlerootTown_BrendansHouse_1F_EventScript_PetalburgGymReport
		VAR_LITTLEROOT_HOUSES_STATE_MAY, 1: LittlerootTown_BrendansHouse_1F_EventScript_YoureNewNeighbor
		VAR_LITTLEROOT_HOUSES_STATE_MAY, 3: PlayersHouse_1F_EventScript_GetSSTicketAndSeeLatiTV
	]
}

script(local) MapScript_LittlerootTown_BrendansHouse_1F_OnLoad {
	if(var(VAR_LITTLEROOT_INTRO_STATE) < 5) {
		call(LittlerootTown_BrendansHouse_1F_EventScript_SetMovingBoxes)
	}
	if(flag(FLAG_RECEIVED_RUNNING_SHOES) == TRUE) {
		call(LittlerootTown_BrendansHouse_1F_EventScript_CheckShowShoesManual)
	}
	end
}

script(local) MapScript_LittlerootTown_BrendansHouse_1F_OnTransition {
	switch(var(VAR_LITTLEROOT_INTRO_STATE)) {
		case 2: call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToDoor)
		case 4: call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToStairs)
		case 5: call(LittlerootTown_BrendansHouse_1F_EventScript_MoveMomToTV)
	}
	end
}

script Script_LittlerootTown_BrendansHouse_1F_Event_EnterHouseWhenMovingIn {
	lockall
	setvar(VAR_0x8004, LOCALID_PLAYERS_HOUSE_1F_MOM)
	setvar(VAR_0x8005, MALE)
	goto(PlayersHouse_1F_EventScript_EnterHouseMovingIn)
	end
}

text(local) Text_PlayersHouse_1F_Mom_ItsNice {
	"Mom: See, {PLAYER}?\n"
	"Isn't it nice in here, too?$"
}

text(local) Text_PlayersHouse_1F_Mom_MoversMonAndSetClock {
	"The mover's Pok\emon do all the work\n"
	"of moving us in and cleaning up after.\l"
	"This is so convenient!\p"
	"{PLAYER}, your room is upstairs.\n"
	"Go check it out, dear!\p"
	"Dad bought you a new clock to mark\n"
	"our move here.\l"
	"Don't forget to set it!$"
}

text(local) Text_PlayersHouse_1F_Mom_InterestedInSeeingYourRoom {
	"Mom: Well, {PLAYER}?\p"
	"Aren't you interested in seeing your\n"
	"very own room?$"
}

text(local) Text_PlayersHouse_1F_Mom_GoSetTheClock {
	"Mom: {PLAYER}.\p"
	"Go set the clock in your room, honey.$"
}

text(local) Text_PlayersHouse_1F_Mom_ComeQuickly {
	"Mom: Oh! {PLAYER}, {PLAYER}!\n"
	"Quick! Come quickly!$"
}

text(local) Text_PlayersHouse_1F_Mom_MaybeDadWillBeOn {
	"MOM: Look! It's Petalburg Gym!\n"
	"Maybe Dad will be on!$"
}

text(local) Text_PlayersHouse_1F_Mom_ItsOver {
	"MOM: Oh\. It's over.\p"
	"I think Dad was on, but we missed him.\n"
	"Too bad."
}

text(local) Text_PlayersHouse_1F_Mom_GoIntroduceYourself {
	"Oh, yes.\n"
	"One of Dad's friends lives in town.\p"
	"Prof. Birch is his name.\p"
	"He lives right next door, so you should\n"
	"go over and introduce yourself.$"
}

text(local) Text_PlayersHouse_1F_Mom_SeeYou {
	"Mom: See you, honey!$"
}

text(local) Text_PlayersHouse_1F_Mom_DidYouMeetProfBirch {
	"Mom: Did you introduce yourself to\n"
	"Prof. Birch?"
}

text(local) Text_PlayersHouse_1F_Mom_YouShouldRest {
	"Mom: How are you doing, {PLAYER}?\n"
	"You look a little tired.\p"
	"I think you should rest a bit.$"
}

text(local) Text_PlayersHouse_1F_Mom_TakeCareHoney {
	"Mom: Take care, honey!"
}

text(local) Text_PlayersHouse_1F_Mom_GotDadsBadge {
	"Mom: Oh? Did Dad give you that Badge?\p"
	"Then here's something from your Mom!$"
}

text(local) Text_PlayersHouse_1F_Mom_DontPushYourself {
	"Don't push yourself too hard, dear.\n"
	"You can always come home.\p"
	"Go for it, honey!"
}

text(local) Text_PlayersHouse_1F_Mom_IsThatPokenav {
	"Mom: What is that, honey? A Pok\eNav?\n"
	"Someone from DEVON gave it to you?\p"
	"Well, honey, how about registering\n"
	"your mom?\p"
	"\. \. \.$"
}

text(local) Text_PlayersHouse_1F_DexNav_RegisterMom {
	"Registered Mom\n"
	"in the Pok\eNav"
}

text(local) Text_PlayersHouse_1F_Vigoroth_Fugi {
	"Fugiiiiih!"
}

text(local) Text_PlayersHouse_1F_Vigoroth_Huggoh {
	"Huggoh, uggo uggo\."
}

text(local) Text_PlayersHouse_1F_RunningShoesManual {
	"It's the instruction booklet for the\n"
	"Running Shoes.\p"
	"“Press the B Button to run while\n"
	"wearing your Rrunning Shoes.\p"
	"“Lace up your Running Shoes and hit\n"
	"the road running!”"
}

text(local) Text_PlayersHouse_1F_Dad_BrineyTicket_TicketFrom {
	"Dad: Hm?\p"
	"Hey, it's {PLAYER}!\p"
	"It's been a while since I saw you,\n"
	"but you look…stronger, somehow.\p"
	"That's the impression I get.\n"
	"But your old man hasn't given up yet!\p"
	"Oh, yes, I have something for you.\n"
	"This came to you from someone named\l"
	"Mr. Briney." 
}

text(local) Text_PlayersHouse_1F_Dad_BrineyTicket_Ports {
	"Dad: Hm, a Ticket for a ferry?\p"
	"If I recall, there are ferry ports in\n"
	"Slateport and Lilycove."
}

text(local) Text_PlayersHouse_1F_Dad_BetterGetBackToGym {
	"I'd better get back to Petalburg Gym.\p"
	"Mom, thanks for looking after the house\n"
	"while I'm away."
}

text(local) Text_PlayersHouse_1F_Mom_DadShouldStayLonger {
	"Mom: That Dad of yours…\p"
	"He comes home for the first time in a\n"
	"while, but all he talks about is Pok\emon.\p"
	"He should relax and stay a little longer."
}

text(local) Text_PlayersHouse_1F_Mom_LatiEvent_BreakingStory {
	"Mom: Is that a breaking news story?"
}

text(local) Text_PlayersHouse_1F_TV_LatiEvent_News {
	"We bring you this emergency\n"
	"news flash!\p"
	"In various Hoenn locales, there have\n"
	"been reports of a BZZT…colored\l"
	"Pok\emon in flight.\p"
	"The identity of this Pok\emon is\n"
	"currently unknown.\p"
	"We now return you to the regular\n"
	"movie program.$"
}

text(local) Text_PlayersHouse_1F_TV_ReportFromPetalburg {
	"Interviewer: …We brought you this\n"
	"report from in front of Petalburg Gym."
}

text(local) Text_PlayersHouse_1F_TV_TwoMenDancingMovie {
	"There is a movie on TV.\p"
	"Two men are dancing on a big piano\n"
	"keyboard.\p"
	"Better get going!"
}

text(local) Text_PlayersHouse_1F_Mom_LatiEvent_WhatColor {
	"Mom: {PLAYER}, did you catch that?\p"
	"What color did the announcer say\n"
	"that Pok\emon was?"
}

text(local) Text_PlayersHouse_1F_Mon_LatiEvent_UnknownPokemon {
	"Mom: Well, isn't that something!\n"
	"There are still unknown Pok\emon."
}
