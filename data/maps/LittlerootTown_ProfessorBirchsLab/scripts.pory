		removeobject(LOCALID_BIRCHS_LAB_MIDDLE_STARTER)
		setflag(FLAG_TOOK_MIDDLE_FIRE_STARTER)
		call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_StarterChoice_End)
	} else {
