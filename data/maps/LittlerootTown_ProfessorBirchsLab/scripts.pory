// Scott call about battle frontier

script(global) Script_LittlerootTown_ProfessorBirchsLab_NavCall_Scott_AboardSSTidal {
	lockall
	pokenavcall(Text_LittlerootTown_ProfessorBirchsLab_Scott_AboardSSTidal)
	waitmessage
	clearflag(FLAG_SCOTT_CALL_BATTLE_FRONTIER)
	releaseall
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Scott_AboardSSTidal {
	"… … … … … …\n"
	"… … … … … Beep!\p"
	"Scott: Hi, hi, {PLAYER}!\n"
	"It's me, Scott.\p"
	"I'm aboard the S.S. Tidal now.\n"
	"It feels great to be on the sea!\p"
	"By the way…\p"
	"There's this place that I'd like to\n"
	"If you're interested, board a ferry\n"
	"at either Slateport or Lilycove.\p"
	"I'll fill you in on the details when\n"
	"we meet. I'll be waiting!\p"
	"… … … … … …\n"
	"… … … … … Click!$"
}
