// Interact Balls

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_StarterChoice_Start {
	msgbox("Do you want to choose {STR_VAR_1}?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) {
		hidemonpic
		msgbox("You did not choose this Pok\emon.", MSGBOX_DEFAULT)
		releaseall
		end
	} else {
		
	}
	call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_GiveStarter)

	playfanfare(MUS_OBTAIN_ITEM)
	msgbox("{PLAYER} recieved the {STR_VAR_1}!")
	waitfanfare
	return
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_StarterChoice_End {
	
	if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
		msgbox("Give a nickname?", MSGBOX_YESNO)
		hidemonpic
		if(var(VAR_RESULT) == YES) {
			call(Common_EventScript_GetGiftMonPartySlot)
			call(Common_EventScript_NameReceivedPartyMon)
		}
	} else {
		msgbox("Give a nicname?", MSGBOX_YESNO)
		hidemonpic
		if(var(VAR_RESULT) == YES) {
			call(Common_EventScript_NameReceivedBoxMon)
		}
		msgbox("Transferred to PC.")
	}
	setflag(FLAG_SYS_POKEMON_GET)
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_GiveStarter {
	if(flag(FLAG_SHINY_STARTERS)) {
		givemon(VAR_0x8006, 5, shinyMode = TRUE)
	} else {
		givemon(VAR_0x8006, 5)
	}
	return
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Examine_PokeBalls {
	"Those are Pok\e Balls\n"
	"They contain Pok\emon!"
}

// Interact Left Ball

script(global) Script_LittlerootTown_ProfessorBirchsLab_Interact_LeftBall {
	lockall
	if(!flag(FLAG_SYS_POKEMON_GET)) {
		bufferstarterinfo(STR_VAR_1, 0)
		showmonpic(VAR_0x8006, 10, 3)
		call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_StarterChoice_Start)
		removeobject(LOCALID_BIRCHS_LAB_LEFT_STARTER)
		setflag(FLAG_TOOK_LEFT_GRASS_STARTER)
		call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_StarterChoice_End)
	} else {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Examine_PokeBalls, MSGBOX_DEFAULT)
	}
	releaseall
	end
}

