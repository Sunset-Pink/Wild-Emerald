text(local) Text_LittlerootTown_ProfessorBirchsLab_Aide_StarterHint_Gen1 {
	format("Aide: These starters have great potential. Bulbasaur can evolve into a Grass/Poison type, and has a Mega Evolution. Charmander can evolve into a Fire/Flying type, and has 2 Mega Evolutions. Squirtle can evolve into a Water type, and has a Mega Evolution. I wonder which you will choose?")
}

